   *    shr                     -
   *    pop.alt                 -
   *    %alt                    -
   */
  {
    #ifdef SCPACK
      "push.alt!load.s.pri %1!const.alt %2!shr!pop.alt!%alt!",
      "load.s.pri %1!const.alt %2!shr!",
    #else
