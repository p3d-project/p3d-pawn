  /* Useless arithmetic operations, like adding or subtracting zero, or
   * multiplying or dividing by 1. Note that subtraction cases are a slightly
   * more convoluted because these operations are not commutative.
   *
   *    const.alt 0             -
   *    add                     -
   *    --------------------------------------
   *    const.pri 0             load.s.pri %1
   *    load.s.alt %1           -
   *    sub                     -
   *    --------------------------------------
   *    const.pri 0             load.pri %1
   *    load.alt %1             -
   *    sub                     -
   *    --------------------------------------
   *    const.alt 1             -
   *    smul                    -
   *    --------------------------------------
   *    const.pri 1             load.s.pri %1
   *    load.s.alt %1           -
   *    sdiv                    -
   *    --------------------------------------
   *    const.pri 1             load.pri %1
   *    load.alt %1             -
   *    sdiv                    -
   */
  {
    #ifdef SCPACK
      "const.alt 0!add!",
      ";!",
    #else
      "\236\222 \246\325",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.s.alt %1!sub!",
      "load.s.pri %1!",
    #else
      "\236\203\246\240\260sub!",
      "\314",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.alt %1!sub!",
      "load.pri %1!",
    #else
      "\236\203\246\221\260sub!",
      "\324",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.alt 1!smul!",
      ";!",
    #else
      "\236\222 \204smul!",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.pri 1!load.s.alt %1!sdiv!",
      "load.s.pri %1!",
    #else
      "\236\203\204\240\260sdiv!",
      "\314",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri 1!load.alt %1!sdiv!",
      "load.pri %1!",
    #else
      "\236\203\204\221\260sdiv!",
      "\324",
    #endif
    3-1, 2-1
  },
  /* Assignment of the first cell of an array (also occurs when a string is
   * reset to an empty string with the syntax: str = "")
   *    addr.alt %1             const.pri %2    ; %2 is typically 0
   *    const.pri %2            stor.s %1
   *    stor.i                  ;exp
   *    ;$exp                   -
   */
  {
    #ifdef SCPACK
      "addr.alt %1!const.pri %2!stor.i!;$exp!",
      "const.pri %2!stor.s %1!;exp!",
    #else
      "\373\345\366\310\261",
      "\345\366\362;\256",
    #endif
    3-2, 2-2
  },
  /* For packed arrays, array access can be optimized (packed arrays
   * do not take advantage of the LIDX or IDXADDR instructions).
   *    addr.pri %1             addr.alt %1
   *    push.pri                load.s.pri %2
   *    load.s.pri %2           bounds %3
   *    bounds %3               -
   *    pop.alt                 -
   *
   * Notes (additional cases):
   * 1. instruction addr.pri can also be const.pri (for
   *    global arrays)
   * 2. the bounds instruction can be absent, but that
   *    case is already handled (see #1#)
   */
  {
    #ifdef SCPACK
      "addr.pri %1!push.pri!load.s.pri %2!bounds %3!pop.alt!",
      "addr.alt %1!load.s.pri %2!bounds %3!",
    #else
      "\327\347\360\264",
      "\373\272\360",
    #endif
    5-3, 3-3
  },
  {
    #ifdef SCPACK
      "const.pri %1!push.pri!load.s.pri %2!bounds %3!pop.alt!",
      "const.alt %1!load.s.pri %2!bounds %3!",
    #else
      "\301\347\360\264",
      "\346\272\360",
    #endif
    5-3, 3-3
  },
  /* During a calculation, the intermediate result must sometimes
   * be moved from PRI to ALT, like in:
   *    push.pri                xchg
   *    load.s.pri %1           load.s.pri %1
   *    pop.alt                 -
   *
   * The above also occurs for "load.pri" and for "const.pri",
   * so add another two cases.
   */
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!pop.alt!",
      "xchg!load.s.pri %1!",
    #else
      "\254\314\264",
      "\270\314",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!load.pri %1!pop.alt!",
      "xchg!load.pri %1!",
    #else
      "\254\324\264",
      "\270\324",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!pop.alt!",
      "xchg!const.pri %1!",
    #else
      "\254\301\264",
      "\270\301",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!zero.pri!pop.alt!",
      "xchg!zero.pri!",
    #else
      "\254\334\243\264",
      "\270\334\243",
    #endif
    3-2, 0-0
  },
  /* An even simpler PUSH/POP optimization (occurs in
   * switch statements):
   *    push.pri                xchg
   *    pop.alt                 -
   * Note that it is somewhat dangerous to do this, as
   * the original sequence keeps PRI and the new sequence
   * destroys it.
   */
  {
    #ifdef SCPACK
      "push.pri!pop.alt!",
      "xchg!",
    #else
      "\254\264",
      "\270",
    #endif
    2-1, 0-0
  },
  /* Redundant pushes (happens in some array operations)
   *    pop.alt                -
   *    push.alt               -
   */
  {
    #ifdef SCPACK
      "pop.alt!push.alt!",
      ";!",
    #else
      "\264\213\250",
      ";!",
    #endif
    2-0, 0-0
  },
  /* Some simple arithmetic sequences
   */
  {
    #ifdef SCPACK
      "xchg!load.s.pri %1!add!",
      "load.s.alt %1!add!",
    #else
      "\270\314\325",
      "\240\260\325",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "xchg!load.pri %1!add!",
      "load.alt %1!add!",
    #else
      "\270\324\325",
      "\221\260\325",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "xchg!const.pri %1!add!",
      "const.alt %1!add!",
    #else
      "\270\301\325",
      "\346\325",
    #endif
    3-2, 1-1
  },
  /* References with a default value generate new cells on the heap
   * dynamically. That code often ends with:
   *    xchg                    push.alt
   *    push.pri                -
   */
  {
    #ifdef SCPACK
      "xchg!push.pri!",
      "push.alt!",
    #else
      "\270\254",
      "\213\250",
    #endif
    2-1, 0-0
  },
  /* Test for zero (common case, especially for strings)
   * E.g. the test expression of: "for (i=0; str{i}!=0; ++i)"
   *
   *    zero.alt                jzer %1
   *    eq                      -
   *    jnz %1                  -
   *    --------------------------------------
   *    zero.alt                jnz %1
   *    eq                      -
   *    jzer %1                 -
   *    --------------------------------------
   *    zero.alt                jzer %1
   *    neq                     -
   *    jzer %1                 -
   */
  {
    #ifdef SCPACK
      "zero.alt!eq!jnz %1!",
      "jzer %1!",
    #else
      "\334\250\330jnz\216",
      "\357",
    #endif
    3-1, 1-1
  },
  {
    #ifdef SCPACK
      "zero.alt!eq!jzer %1!",
      "jnz %1!",
    #else
      "\334\250\330\357",
      "jnz\216",
    #endif
    3-1, 1-1
  },
  {
    #ifdef SCPACK
      "zero.alt!neq!jzer %1!",
      "jzer %1!",
    #else
      "\334\250n\330\357",
      "\357",
    #endif
    3-1, 1-1
  },
  /* Array comparison has a NOT instruction that can sometimes be optimized away
   *    not                     jnz %1
   *    jzer %1                 -
   *    --------------------------------------
   *    not                     jzer %1
   *    jnz %1                  -
   */
  {
    #ifdef SCPACK
      "not!jzer %1!",
      "jnz %1!",
    #else
      "not!\357",
      "jnz\216",
    #endif
    2-1, 1-1
  },
  {
    #ifdef SCPACK
      "not!jnz %1!",
      "jzer %1!",
    #else
      "not!jnz\216",
      "\357",
    #endif
    2-1, 1-1
  },

  /* Incrementing and decrementing global and local variables, and reference
   * arguments may have redundant PUSH/POP instructions, for example when the
   * primary register is altered after restoring it, or at the end of an
   * expression.
   *    push.pri                load.s.pri %1   ; reference argument
   *    load.s.pri %1           inc.i
   *    inc.i                   lref.s.pri %2
   *    pop.pri                 -
   *    lref.s.pri %2           -
   *    --------------------------------------
   *    push.pri                load.s.pri %1
   *    load.s.pri %1           inc.i
   *    inc.i                   ;$exp
   *    pop.pri                 -
   *    ;$exp                   -
   *    --------------------------------------
   *    push.pri                addr.pri %1     ; local variable
   *    addr.pri %1             inc.i
   *    inc.i                   load.s.pri %2
   *    pop.pri                 -
   *    load.s.pri %2           -
   *    --------------------------------------
   *    push.pri                const.pri %1    ; global variable
   *    const.pri %1            inc.i
   *    inc.i                   load.pri %2
   *    pop.pri                 -
   *    load.pri %2             -
   * The same is true for dec.i sequences.
   */
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!inc.i!pop.pri!lref.s.pri %2!",
      "load.s.pri %1!inc.i!lref.s.pri %2!",
    #else
      "\254\314\316\310\367\315\241",
      "\314\316\310\315\241",
    #endif
    5-3, 2-2
  },
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!inc.i!pop.pri!;$exp!",
      "load.s.pri %1!inc.i!;$exp!",
    #else
      "\254\314\316\310\367\261",
      "\314\316\310\261",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!inc.i!pop.pri!;load.s.pri %2!",
      "addr.pri %1!inc.i!;load.s.pri %2!",
    #else
      "\254\327\316\310\367;\272",
      "\327\316\310;\272",
    #endif
    5-3, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!inc.i!pop.pri!;$exp!",
      "addr.pri %1!inc.i!;$exp!",
    #else
      "\254\327\316\310\367\261",
      "\327\316\310\261",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!inc.i!pop.pri!;load.pri %2!",
      "const.pri %1!inc.i!;load.pri %2!",
    #else
      "\254\301\316\310\367;\355",
      "\301\316\310;\355",
    #endif
    5-3, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!inc.i!pop.pri!;$exp!",
      "const.pri %1!inc.i!;$exp!",
    #else
      "\254\301\316\310\367\261",
      "\301\316\310\261",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!dec.i!pop.pri!lref.s.pri %2!",
      "load.s.pri %1!dec.i!lref.s.pri %2!",
    #else
      "\254\314\320\310\367\315\241",
      "\314\320\310\315\241",
    #endif
    5-3, 2-2
  },
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!dec.i!pop.pri!;$exp!",
      "load.s.pri %1!dec.i!;$exp!",
    #else
      "\254\314\320\310\367\261",
      "\314\320\310\261",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!dec.i!pop.pri!;load.s.pri %2!",
      "addr.pri %1!dec.i!;load.s.pri %2!",
    #else
      "\254\327\320\310\367;\272",
      "\327\320\310;\272",
    #endif
    5-3, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!dec.i!pop.pri!;$exp!",
      "addr.pri %1!dec.i!;$exp!",
    #else
      "\254\327\320\310\367\261",
      "\327\320\310\261",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!dec.i!pop.pri!;load.pri %2!",
      "const.pri %1!dec.i!;load.pri %2!",
    #else
      "\254\301\320\310\367;\355",
      "\301\320\310;\355",
    #endif
    5-3, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!dec.i!pop.pri!;$exp!",
      "const.pri %1!dec.i!;$exp!",
    #else
      "\254\301\320\310\367\261",
      "\301\320\310\261",
    #endif
    4-2, 1-1
  },
  /* Due to optimizing out redundant PUSH/POP instructions (see above), there
   * may now be a redundant load.
   *
   *    const.pri %1            const.pri %2
   *    const.pri %2            -
   *    --------------------------------------
   *    load.pri %1             const.pri %2
   *    const.pri %2            -
   *    --------------------------------------
   *    load.s.pri %1           addr.pri %2
   *    addr.pri %2             -
   *    --------------------------------------
   *    const.pri %1            zero.pri
   *    zero.pri                -
   */
  {
    #ifdef SCPACK
      "const.pri %1!const.pri %2!",
      "const.pri %2!",
    #else
      "\301\345",
      "\345",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "load.pri %1!const.pri %2!",
      "const.pri %2!",
    #else
      "\324\345",
      "\345",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "load.s.pri %1!addr.pri %2!",
      "addr.pri %2!",
    #else
      "\314\274\241",
      "\274\241",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri %1!zero.pri!",
      "zero.pri!",
    #else
      "\301\334\243",
      "\334\243",
    #endif
    2-1, 1-0
