  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!dec.i!pop.pri!%pri!",
      "load.s.pri %1!dec.i!",
    #else
      "\255\311\327\323\254\247\307",
      "\311\327\323",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!dec.i!pop.pri!%pri!",
      "addr.pri %1!dec.i!",
    #else
      "\255\333\327\323\254\247\307",
      "\333\327\323",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!dec.i!pop.pri!%pri!",
      "const.pri %1!dec.i!",
    #else
