   *    add                     -
   *    --------------------------------------
   *    const.pri 0             load.s.pri %1
   *    load.s.alt %1           -
   *    sub                     -
   *    --------------------------------------
   *    const.pri 0             load.pri %1
   *    load.alt %1             -
   *    sub                     -
   *    --------------------------------------
   *    const.alt 1             -
   *    smul                    -
   *    --------------------------------------
   *    const.pri 1             load.s.pri %1
   *    load.s.alt %1           -
   *    sdiv                    -
   *    --------------------------------------
   *    const.pri 1             load.pri %1
   *    load.alt %1             -
   *    sdiv                    -
   *    --------------------------------------
   *    const pri 0             xchg
   *    xchg                    -
   *    shl                     -
   *    --------------------------------------
   *    const pri 0             xchg
   *    xchg                    -
   *    shr                     -
   *    --------------------------------------
   *    const pri 0             xchg
   *    xchg                    -
   *    sshr                    -
   */
  {
    #ifdef SCPACK
      "const.alt 0!add!",
      ";!",
    #else
      "\234\217 \242\317",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.s.alt %1!sub!",
      "load.s.pri %1!",
    #else
      "\234\203\242\235\251sub!",
      "\311",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.alt %1!sub!",
      "load.pri %1!",
    #else
      "\234\203\242\222\251sub!",
      "\316",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.alt 1!smul!",
      ";!",
    #else
      "\234\217 \204smul!",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.pri 1!load.s.alt %1!sdiv!",
      "load.s.pri %1!",
    #else
      "\234\203\204\235\251sdiv!",
      "\311",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri 1!load.alt %1!sdiv!",
      "load.pri %1!",
    #else
      "\234\203\204\222\251sdiv!",
      "\316",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.alt 0!shl!",
      ";!",
    #else
      "\234\217 \242\312!",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.alt 0!shr!",
      ";!",
    #else
      "\234\217 \242\211r!",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.alt 0!sshr!",
      ";!",
    #else
      "\234\217 \242s\211r!",
      ";!",
    #endif
    2-0, 1-0
  },
  /* Assignment of the first cell of an array (also occurs when a string is
   * reset to an empty string with the syntax: str = "")
   *    addr.alt %1             const.pri %2    ; %2 is typically 0
   *    const.pri %2            stor.s %1
   *    stor.i                  -
   *    %alt                    -
   */
  {
    #ifdef SCPACK
      "addr.alt %1!const.pri %2!stor.i!%alt!",
      "const.pri %2!stor.s %1!",
    #else
      "\361\340\360\322%a\216!",
      "\340\360\315",
    #endif
    3-2, 2-2
  },
  /* For packed arrays, array access can be optimized (packed arrays
   * do not take advantage of the LIDX or IDXADDR instructions).
   *    addr.pri %1             addr.alt %1
   *    push.pri                load.s.pri %2
   *    load.s.pri %2           bounds %3
   *    bounds %3               -
   *    pop.alt                 -
   *
   * Notes (additional cases):
   * 1. instruction addr.pri can also be const.pri (for
   *    global arrays)
   * 2. the bounds instruction can be absent, but that
   *    case is already handled (see #1#)
   */
  {
    #ifdef SCPACK
      "addr.pri %1!push.pri!load.s.pri %2!bounds %3!pop.alt!",
      "addr.alt %1!load.s.pri %2!bounds %3!",
    #else
      "\332\337\350\260",
      "\361\267\350",
    #endif
    5-3, 3-3
  },
  {
    #ifdef SCPACK
      "const.pri %1!push.pri!load.s.pri %2!bounds %3!pop.alt!",
      "const.alt %1!load.s.pri %2!bounds %3!",
    #else
      "\273\337\350\260",
      "\341\267\350",
    #endif
    5-3, 3-3
  },
  /* During a calculation, the intermediate result must sometimes
   * be moved from PRI to ALT, like in:
   *    push.pri                xchg
   *    load.s.pri %1           load.s.pri %1
   *    pop.alt                 -
   *
   * The above also occurs for "load.pri" and for "const.pri",
   * so add another two cases.
   */
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!pop.alt!",
      "xchg!load.s.pri %1!",
    #else
      "\255\311\260",
      "\266\311",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!load.pri %1!pop.alt!",
      "xchg!load.pri %1!",
    #else
      "\255\316\260",
      "\266\316",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!pop.alt!",
      "xchg!const.pri %1!",
    #else
      "\255\273\260",
      "\266\273",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!zero.pri!pop.alt!",
      "xchg!zero.pri!",
    #else
      "\255\331\247\260",
      "\266\331\247",
    #endif
    3-2, 0-0
  },
  /* An even simpler PUSH/POP optimization (occurs in
   * switch statements):
   *    push.pri                xchg
   *    pop.alt                 -
   * Note that it is somewhat dangerous to do this, as
   * the original sequence keeps PRI and the new sequence
   * destroys it.
   */
  {
    #ifdef SCPACK
      "push.pri!pop.alt!",
      "xchg!",
    #else
      "\255\260",
      "\266",
    #endif
    2-1, 0-0
  },
  /* Redundant pushes (happens in some array operations)
   *    pop.alt                -
   *    push.alt               -
   */
  {
    #ifdef SCPACK
      "pop.alt!push.alt!",
      ";!",
    #else
      "\260\213\250",
      ";!",
    #endif
    2-0, 0-0
  },
  /* Some simple arithmetic sequences
   */
  {
    #ifdef SCPACK
      "xchg!load.s.pri %1!add!",
      "load.s.alt %1!add!",
    #else
      "\266\311\317",
      "\235\251\317",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "xchg!load.pri %1!add!",
      "load.alt %1!add!",
    #else
      "\266\316\317",
      "\222\251\317",
    #endif
    3-2, 1-1
  },
  {
    #ifdef SCPACK
      "xchg!const.pri %1!add!",
      "const.alt %1!add!",
    #else
      "\266\273\317",
      "\341\317",
    #endif
    3-2, 1-1
  },
  /* References with a default value generate new cells on the heap
   * dynamically. That code often ends with:
   *    xchg                    push.alt
   *    push.pri                -
   */
  {
    #ifdef SCPACK
      "xchg!push.pri!",
      "push.alt!",
    #else
      "\266\255",
      "\213\250",
    #endif
    2-1, 0-0
  },
  /* Test for zero (common case, especially for strings)
   * E.g. the test expression of: "for (i=0; str{i}!=0; ++i)"
   *
   *    zero.alt                jzer %1
   *    eq                      -
   *    jnz %1                  -
   *    --------------------------------------
   *    zero.alt                jnz %1
   *    eq                      -
   *    jzer %1                 -
   *    --------------------------------------
   *    zero.alt                jzer %1
   *    neq                     -
   *    jzer %1                 -
   */
  {
    #ifdef SCPACK
      "zero.alt!eq!jnz %1!",
      "jzer %1!",
    #else
      "\331\250\277jnz\220",
      "\365",
    #endif
    3-1, 1-1
  },
  {
    #ifdef SCPACK
      "zero.alt!eq!jzer %1!",
      "jnz %1!",
    #else
      "\331\250\277\365",
      "jnz\220",
    #endif
    3-1, 1-1
  },
  {
    #ifdef SCPACK
      "zero.alt!neq!jzer %1!",
      "jzer %1!",
    #else
      "\331\250n\277\365",
      "\365",
    #endif
    3-1, 1-1
  },
  /* Array comparison has a NOT instruction that can sometimes be optimized away
   *    not                     jnz %1
   *    jzer %1                 -
   *    --------------------------------------
   *    not                     jzer %1
   *    jnz %1                  -
   */
  {
    #ifdef SCPACK
      "not!jzer %1!",
      "jnz %1!",
    #else
      "not!\365",
      "jnz\220",
    #endif
    2-1, 1-1
  },
  {
    #ifdef SCPACK
      "not!jnz %1!",
      "jzer %1!",
    #else
      "not!jnz\220",
      "\365",
    #endif
    2-1, 1-1
  },
  /* Incrementing and decrementing global and local variables, and reference
   * arguments may have redundant PUSH/POP instructions, for example when the
   * primary register is altered after restoring it, or at the end of an
   * expression.
   *    push.pri                load.s.pri %1   ; reference argument
   *    load.s.pri %1           inc.i
   *    inc.i                   -
   *    pop.pri                 -
   *    %pri                    -
   *    --------------------------------------
   *    push.pri                addr.pri %1     ; local variable
   *    addr.pri %1             inc.i
   *    inc.i                   -
   *    pop.pri                 -
   *    %pri                    -
   *    --------------------------------------
   *    push.pri                const.pri %1    ; global variable
   *    const.pri %1            inc.i
   *    inc.i                   -
   *    pop.pri                 -
   *    %pri                    -
   * The same is true for dec.i sequences.
   */
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!inc.i!pop.pri!%pri!",
      "load.s.pri %1!inc.i!",
    #else
      "\255\311\324\322\254\247\307",
      "\311\324\322",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!inc.i!pop.pri!%pri!",
      "addr.pri %1!inc.i!",
    #else
      "\255\332\324\322\254\247\307",
      "\332\324\322",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!inc.i!pop.pri!%pri!",
      "const.pri %1!inc.i!",
    #else
      "\255\273\324\322\254\247\307",
      "\273\324\322",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!load.s.pri %1!dec.i!pop.pri!%pri!",
      "load.s.pri %1!dec.i!",
    #else
      "\255\311\326\322\254\247\307",
      "\311\326\322",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!addr.pri %1!dec.i!pop.pri!%pri!",
      "addr.pri %1!dec.i!",
    #else
      "\255\332\326\322\254\247\307",
      "\332\326\322",
    #endif
    4-2, 1-1
  },
  {
    #ifdef SCPACK
      "push.pri!const.pri %1!dec.i!pop.pri!%pri!",
      "const.pri %1!dec.i!",
    #else
      "\255\273\326\322\254\247\307",
      "\273\326\322",
    #endif
    4-2, 1-1
  },
  /* Sometimes a register is saved and restored, but that restored
   * value is then immediately discarded.
   *
   *    push.alt                load.s.pri %1
   *    load.s.pri %1           const.alt %2
   *    const.alt %2            shr
   *    shr                     -
   *    pop.alt                 -
   *    %alt                    -
   */
  {
    #ifdef SCPACK
      "push.alt!load.s.pri %1!const.alt %2!shr!pop.alt!%alt!",
      "load.s.pri %1!const.alt %2!shr!",
    #else
      "\213\250\311\234\310\211r!\260%a\216!",
      "\311\234\310\211r!",
    #endif
    5-3, 2-2
  },
  /* Due to optimizing out redundant PUSH/POP instructions (see above), there
   * may now be a redundant load.
   *
   *    const.pri %1            const.pri %2
   *    const.pri %2            -
   *    --------------------------------------
   *    load.pri %1             const.pri %2
   *    const.pri %2            -
   *    --------------------------------------
   *    load.s.pri %1           addr.pri %2
   *    addr.pri %2             -
   *    --------------------------------------
   *    const.pri %1            zero.pri
   *    zero.pri                -
   */
  {
    #ifdef SCPACK
      "const.pri %1!const.pri %2!",
      "const.pri %2!",
    #else
      "\273\340",
      "\340",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "load.pri %1!const.pri %2!",
      "const.pri %2!",
    #else
      "\316\340",
      "\340",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "load.s.pri %1!addr.pri %2!",
      "addr.pri %2!",
    #else
      "\311\261\240",
      "\261\240",
    #endif
    2-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri %1!zero.pri!",
      "zero.pri!",
    #else
      "\273\331\247",
      "\331\247",
    #endif
    2-1, 1-0
