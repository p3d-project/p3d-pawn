   *    --------------------------------------
   *    const.pri 0             load.s.pri %1
   *    load.s.alt %1           -
   *    sub                     -
   *    --------------------------------------
   *    const.pri 0             load.pri %1
   *    load.alt %1             -
   *    sub                     -
   *    --------------------------------------
   *    const.alt 1             -
   *    smul                    -
   *    --------------------------------------
   *    const.pri 1             load.s.pri %1
   *    load.s.alt %1           -
   *    sdiv                    -
   *    --------------------------------------
   *    const.pri 1             load.pri %1
   *    load.alt %1             -
   *    sdiv                    -
   */
  {
    #ifdef SCPACK
      "const.alt 0!add!",
      ";!",
    #else
      "\243\222 \246\326",
      ";!",
    #endif
    2-0, 1-0
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.s.alt %1!sub!",
      "load.s.pri %1!",
    #else
      "\243\203\246\235\255sub!",
      "\315",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.pri 0!load.alt %1!sub!",
      "load.pri %1!",
    #else
      "\243\203\246\221\255sub!",
      "\324",
    #endif
    3-1, 2-1
  },
  {
    #ifdef SCPACK
      "const.alt 1!smul!",
