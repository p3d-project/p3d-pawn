   * Caveat: in the replacement snipped, ALT is not set.
   */
  {
    #ifdef SCPACK
      "const.pri %1!const.alt %2!add!",
      "const.pri %1+%2!",
    #else
      "\301\236\321\325",
      "\236\2301+%\215",
    #endif
    3-1, 2-1
  },
  /* There is a special opcode for left-shift by a constant, use it...
   *
   *    const alt %1            shl.c.pri %1
   *    shl                     -
   */
  {
    #ifdef SCPACK
      "const.alt %1!shl!",
      "shl.c.pri %1!",
    #else
      "\346\331!",
      "\344\225",
    #endif
